# Plantilla de variables de entorno (ver DEPLOY.md §"Variables de entorno").
# Copiar a .env y ajustar. NUNCA commitear el .env real.

# --- Postgres (docker-compose) ---
POSTGRES_USER=veredicto
POSTGRES_PASSWORD=veredicto
POSTGRES_DB=veredicto
POSTGRES_PORT=5432

# --- Aplicación ---
DATABASE_URL=postgresql+psycopg://veredicto:veredicto@localhost:5432/veredicto
ENV=local
LOG_LEVEL=INFO
BURO_MODE=simulado
MCP_TRANSPORT=stdio
